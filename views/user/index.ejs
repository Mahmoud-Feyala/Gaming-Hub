<%- include('../includes/head.ejs') %>

<script src="https://unpkg.com/@phosphor-icons/web"></script>

<div class="bg-shapes">
  <div class="shape shape-1"></div>
  <div class="shape shape-2"></div>
  <div class="shape shape-3"></div>
  <div class="shape shape-4"></div>
  <div class="shape shape-5">★</div>
  <div class="shape shape-6">★</div>
  <div class="shape shape-7">★</div>
</div>
<%- include('../includes/navbar.ejs') %>

<main class="page-wrapper">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">

        <div class="hero-left">
          <div class="hero-eyebrow">The Ultimate Gaming Hub</div>
          <h1 class="hero-title">
            Rate, Review <br />
            <span class="highlight">Discover</span><br />
            <span class="accent">Epic Games</span>
          </h1>
          <p class="hero-desc">
            Gaming Hub is the definitive platform for gamers to discover
            incredible games, write honest reviews, and build their personal
            gaming legacy.
          </p>
          <div class="hero-actions">
            <% if (isAuth === true) { %>
            <a href="/games" class="btn btn-primary btn-lg btn-block">Browse Games →</a>
            <% } else { %>
            <a href="/games" class="btn btn-primary btn-lg">Browse Games →</a>
            <a href="/register" class="btn btn-outline btn-lg">Join Free</a>
            <% } %>
          </div>
          <div class="hero-stats">
            <div class="hero-stat-item">
              <div class="hero-stat-value">12K+</div>
              <div class="hero-stat-label">Games Listed</div>
            </div>
            <div class="hero-stat-item">
              <div class="hero-stat-value">89K+</div>
              <div class="hero-stat-label">Reviews Written</div>
            </div>
            <div class="hero-stat-item">
              <div class="hero-stat-value">42K+</div>
              <div class="hero-stat-label">Active Players</div>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-card-main">
            <div class="hero-card-placeholder">
              <img src="https://assets.xboxservices.com/assets/36/b5/36b52fa8-e71b-4435-888a-cecb98d3876a.jpg?n=153142244433_GLP-Page-Hero-0_1083x1222_02.jpg" alt="Valorant" class="slider-image active">
              <img src="https://www.nintendo.com/eu/media/images/assets/nintendo_switch_games/overwatch2/16x9_Overwatch2_Season21_image1600w.jpg" alt="Overwatch 2" class="slider-image">
              <img src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1174180/library_600x900_2x.jpg" alt="Red Dead Redemption 2" class="slider-image">
              <img src="https://image.api.playstation.com/vulcan/ap/rnd/202606/0223/2b45ffdc87a244071f01132ca6dbef90c4454e47aee7ca82.png" alt="Game 4" class="slider-image">
              <img src="https://image.api.playstation.com/vulcan/ap/rnd/202404/0814/6337d7fda029c89f7d02de0825db21fdd8ab46d36cbcc82c.png" alt="Game 5" class="slider-image">
              <img src="https://myhotposters.com/cdn/shop/products/mL4252_1024x1024.jpg?v=1748533723" alt="Game 6" class="slider-image">
            </div>
            <div class="hero-card-overlay"></div>
            <div class="hero-card-content">
              <div class="hero-game-genre">Game of the Month</div>
              <div class="hero-game-title">Top Picks</div>
              <div class="hero-rating">
                <div class="stars">
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                </div>

                <span class="rating-score">4.9 / 5.0</span>
                <span class="rating-count">(389 reviews)</span>
              </div>
            </div>
            <div class="slider-dots" id="sliderDots"></div>
          </div>

          <div class="hero-float-cards">
            <div class="hero-mini-card">
              <div class="hero-mini-card-title">Trending Now</div>
              <div class="hero-mini-card-sub">New Updates Available</div>
            </div>
            <div class="hero-mini-card">
              <div class="hero-mini-card-title">New Release</div>
              <div class="hero-mini-card-sub">Check Out Store</div>
            </div>
          </div>

          <div class="hero-bubbles">
            <div class="bubble bubble-yellow"></div>
            <div class="bubble bubble-cyan"></div>
          </div>
        </div>

      </div>
    </div>
  </section>
  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>

  <!-- Genre -->
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">— Browse</div>
      <h2 class="section-title">Explore by Genre</h2>
      <div class="grid-4">
        <!-- RPG Card -->
        <a href="/games" class="card genre-card genre-card--dark">
          <div class="genre-icon">
            <i class="ph-bold ph-sword"></i>
          </div>
          <div class="genre-name genre-name--light">RPG</div>
          <div class="genre-count">8 games</div>
        </a>

        <!-- Racing Card -->
        <a href="/games" class="card genre-card genre-card--pink">
          <div class="genre-icon">
            <i class="ph-bold ph-flag-checkered"></i>
          </div>
          <div class="genre-name">Racing</div>
          <div class="genre-count">5 games</div>
        </a>

        <!-- Action Card -->
        <a href="/games" class="card genre-card genre-card--yellow">
          <div class="genre-icon">
            <i class="ph-bold ph-crosshair"></i>
          </div>
          <div class="genre-name">Action</div>
          <div class="genre-count genre-count--dark">7 games</div>
        </a>

        <!-- Strategy Card -->
        <a href="/games" class="card genre-card genre-card--cyan">
          <div class="genre-icon">
            <i class="ph-bold ph-castle-turret"></i>
          </div>
          <div class="genre-name">Strategy</div>
          <div class="genre-count genre-count--dark">3 games</div>
        </a>
      </div>
    </div>
  </section>

  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>
  <!-- Featured Games -->
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">— Featured</div>
      <h2 class="section-title">Featured Games</h2>
      <div class="featured-games">
        <% featuredGames.forEach(game => { %>
        <div class="game-card" data-title="<%= game.title %>" data-genre="<%= game.genre %>" data-developer="<%= game.developer %>">
          <div class="game-card-img">
            <img src="<%= game.imageUrl %>" alt="<%= game.title %>" />
            <% if (game.badge) { %>
            <span class="game-card-badge game-card-badge--default"><%= game.badge %></span>
            <% } %>
          </div>
          <div class="game-card-body">
            <div class="game-card-meta"><%= game.platform %> • <%= game.year %></div>
            <h3 class="game-card-title"><%= game.title %></h3>
            <div class="game-card-sub"><%= game.genre %> | <%= game.developer %></div>
            <p class="game-card-desc"><%= game.description %></p>
            <a href="/game-details/<%= game._id %>" class="game-card-btn">View Game</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <!-- Trending Reviews -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="section-eyebrow">— COMMUNITY</div>
          <h2 class="section-title">Trending Reviews</h2>
          <p class="section-subtitle">What the community is saying</p>
        </div>

        <a href="/games" class="btn btn-outline">More Reviews →</a>
      </div>

      <div class="grid-3">

        <% if (typeof trendingReviews !== 'undefined' && trendingReviews.length > 0) { %>

        <% trendingReviews.forEach(review => { %>

        <%
            const avatars = [];
            for (let i = 2; i <= 10; i++) {
              avatars.push(`${i}.png`);
            }
            const randomAvatar = avatars[Math.floor(Math.random() * avatars.length)];
          %>

        <div class="review-card">
          <div class="review-card-header">

            <div class="review-avatar">
              <img src="/assets/images/<%= randomAvatar %>" alt="Gaming Hub Profile" />
            </div>

            <div class="review-user-info">
              <div class="review-username">
                <%= review.user && review.user.username ? review.user.username : 'Unknown User' %>
              </div>
              <div class="review-date">
                <%= new Date(review.createdAt).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  }) %>
                •
                <%= review.game && review.game.title ? review.game.title : 'Game' %>
              </div>
            </div>

            <div class="stars" style="flex-shrink: 0;">
              <% for (let i = 1; i <= 5; i++) { %>
              <span class="star <%= i <= review.rating ? 'filled' : '' %>">★</span>
              <% } %>
            </div>

          </div>

          <p class="review-text"><%= review.review %></p>
        </div>

        <% }) %>

        <% } else { %>

        <div class="reviews-empty grid-span-all">
          No reviews yet. Be the first to review a game!
        </div>

        <% } %>

      </div>
    </div>
  </section>

  <!-- الفاصل عشان الـ Spacing -->
  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>

  <!-- الفاصل دا هيدي مساحة (Spacing) محترمة من تحت قبل الـ CTA -->
  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>
  <!-- CTA -->
  <section class="section section--no-top">
    <div class="container">
      <div class="cta-block">
        <div class="cta-glow" aria-hidden="true"></div>
        <div class="cta-content">
          <div class="cta-eyebrow">Join the Community</div>
          <h2 class="cta-title">Your Gaming Legacy<br />Starts Here</h2>
          <p class="cta-desc">
            Join thousands of gamers discovering hidden gems, sharing unforgettable moments,
            and building their ultimate game libraries.
          </p>
          <div class="cta-actions">
            <% if (isAuth === true) { %>
            <a href="/games" class="btn btn-cyan btn-lg btn-block">Browse Games →</a>
            <% } else { %>
            <a href="/register" class="btn btn-cyan btn-lg">Create Free Account →</a>
            <a href="/games" class="btn btn-outline-white btn-lg">Browse Games</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('../includes/footer.ejs') %>


<button class="back-to-top" id="backToTop" aria-label="Back to top">↑</button>

<link rel="stylesheet" href="/css/style.css" />
<script src="/js/app.js" defer></script>


<%- include('../includes/end.ejs') %>