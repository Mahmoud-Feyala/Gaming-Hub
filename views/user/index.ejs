<%- include('../includes/head.ejs') %>

<script src="https://unpkg.com/@phosphor-icons/web"></script>

<div class="bg-shapes">
  <div class="shape shape-1"></div>
  <div class="shape shape-2"></div>
  <div class="shape shape-3"></div>
  <div class="shape shape-4"></div>
  <div class="shape shape-5">★</div>
  <div class="shape shape-6">★</div>
  <div class="shape shape-7">★</div>
</div>
<%- include('../includes/navbar.ejs') %>

<main class="page-wrapper">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">

        <div class="hero-left">
          <div class="hero-eyebrow">The Ultimate Gaming Hub</div>
          <h1 class="hero-title">
            Rate, Review <br />
            <span class="highlight">Discover</span><br />
            <span class="accent">Epic Games</span>
          </h1>
          <p class="hero-desc">
            Gaming Hub is the definitive platform for gamers to discover
            incredible games, write honest reviews, and build their personal
            gaming legacy.
          </p>
          <div class="hero-actions">
            <% if (isAuth === true) { %>
            <a href="/games" class="btn btn-primary btn-lg" style="width:100%;text-align:center">Browse Games →</a>
            <% } else { %>
            <a href="/games" class="btn btn-primary btn-lg">Browse Games →</a>
            <a href="/register" class="btn btn-outline btn-lg">Join Free</a>
            <% } %>
          </div>
          <div class="hero-stats">
            <div class="hero-stat-item">
              <div class="hero-stat-value">12K+</div>
              <div class="hero-stat-label">Games Listed</div>
            </div>
            <div class="hero-stat-item">
              <div class="hero-stat-value">89K+</div>
              <div class="hero-stat-label">Reviews Written</div>
            </div>
            <div class="hero-stat-item">
              <div class="hero-stat-value">42K+</div>
              <div class="hero-stat-label">Active Players</div>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-card-main">
            <div class="hero-card-placeholder">
              <img src="https://assets.xboxservices.com/assets/36/b5/36b52fa8-e71b-4435-888a-cecb98d3876a.jpg?n=153142244433_GLP-Page-Hero-0_1083x1222_02.jpg" alt="Valorant" class="slider-image active">
              <img src="https://www.nintendo.com/eu/media/images/assets/nintendo_switch_games/overwatch2/16x9_Overwatch2_Season21_image1600w.jpg" alt="Overwatch 2" class="slider-image">
              <img src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1174180/library_600x900_2x.jpg" alt="Red Dead Redemption 2" class="slider-image">
              <img src="https://image.api.playstation.com/vulcan/ap/rnd/202606/0223/2b45ffdc87a244071f01132ca6dbef90c4454e47aee7ca82.png" alt="Game 4" class="slider-image">
              <img src="https://image.api.playstation.com/vulcan/ap/rnd/202404/0814/6337d7fda029c89f7d02de0825db21fdd8ab46d36cbcc82c.png" alt="Game 5" class="slider-image">
              <img src="https://myhotposters.com/cdn/shop/products/mL4252_1024x1024.jpg?v=1748533723" alt="Game 6" class="slider-image">
            </div>
            <div class="hero-card-overlay"></div>
            <div class="hero-card-content">
              <div class="hero-game-genre">Game of the Month</div>
              <div class="hero-game-title">Top Picks</div>
              <div class="hero-rating">
                <div class="stars">
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                </div>

                <span class="rating-score">4.9 / 5.0</span>
                <span class="rating-count">(389 reviews)</span>
              </div>
            </div>
            <div class="slider-dots" id="sliderDots"></div>
          </div>

          <div class="hero-float-cards">
            <div class="hero-mini-card">
              <div class="hero-mini-card-title">Trending Now</div>
              <div class="hero-mini-card-sub">New Updates Available</div>
            </div>
            <div class="hero-mini-card">
              <div class="hero-mini-card-title">New Release</div>
              <div class="hero-mini-card-sub">Check Out Store</div>
            </div>
          </div>

          <div class="hero-bubbles">
            <div class="bubble bubble-yellow"></div>
            <div class="bubble bubble-cyan"></div>
          </div>
        </div>

      </div>
    </div>
  </section>
  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>

  <!-- Genre -->
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">— Browse</div>
      <h2 class="section-title">Explore by Genre</h2>
      <div class="grid-4">
        <!-- RPG Card -->
        <a href="/games" class="card genre-card genre-card--dark">
          <div class="genre-icon">
            <i class="ph-bold ph-sword"></i>
          </div>
          <div class="genre-name genre-name--light">RPG</div>
          <div class="genre-count">8 games</div>
        </a>

        <!-- Racing Card -->
        <a href="/games" class="card genre-card" style="background: var(--pink);">
          <div class="genre-icon">
            <i class="ph-bold ph-flag-checkered"></i>
          </div>
          <div class="genre-name">Racing</div>
          <div class="genre-count">5 games</div>
        </a>

        <!-- Action Card -->
        <a href="/games" class="card genre-card genre-card--yellow">
          <div class="genre-icon">
            <i class="ph-bold ph-crosshair"></i>
          </div>
          <div class="genre-name">Action</div>
          <div class="genre-count genre-count--dark">7 games</div>
        </a>

        <!-- Strategy Card -->
        <a href="/games" class="card genre-card genre-card--cyan">
          <div class="genre-icon">
            <i class="ph-bold ph-castle-turret"></i>
          </div>
          <div class="genre-name">Strategy</div>
          <div class="genre-count genre-count--dark">3 games</div>
        </a>
      </div>
    </div>
  </section>

  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>
  <!-- Featured Games -->
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">— Featured</div>
      <h2 class="section-title">Featured Games</h2>
      <div class="featured-games">
        <% featuredGames.forEach(game => { %>
        <div class="game-card" data-title="<%= game.title %>" data-genre="<%= game.genre %>" data-developer="<%= game.developer %>" style="background: var(--black, #111); color: #fff; border: 2px solid #000; border-radius: 8px; overflow: hidden; box-shadow: 4px 4px 0px rgba(0,0,0,0.2); display: flex; flex-direction: column;">
          <div class="card-image-container" style="border-bottom: 2px solid #000; position: relative; overflow: hidden;">
            <img src="<%= game.imageUrl %>" alt="<%= game.title %>" style="width: 100%; display: block;" />
            <% if (game.badge) { %>
            <span style="position: absolute; top: 8px; right: 8px; background: #ff6b6b; color: #fff; padding: 4px 8px; font-size: 0.7rem; font-family: var(--font-mono); border-radius: 4px; border: 1px solid #000; text-transform: uppercase; z-index: 2;"><%= game.badge %></span>
            <% } %>
          </div>
          <div style="padding: 16px; flex-grow: 1; display: flex; flex-direction: column;">
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: #888; text-transform: uppercase; margin-bottom: 8px;"><%= game.platform %> • <%= game.year %></div>
            <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 4px 0;"><%= game.title %></h3>
            <div style="font-size: 0.8rem; color: #aaa; margin-bottom: 12px;"><%= game.genre %> | <%= game.developer %></div>
            <p style="font-size: 0.85rem; line-height: 1.4; color: #ddd; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;"><%= game.description %></p>
            <a href="/game-details/<%= game._id %>" class="btn btn-cyan" style="width: 100%; text-align: center; margin-top: auto;">View Game</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <!-- Trending Reviews -->
  <section class="section">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;">
        <div>
          <div class="section-eyebrow" style="color: #000;">— COMMUNITY</div>
          <h2 class="section-title" style="margin-bottom: 8px; color: #000;">Trending Reviews</h2>
          <p style="color: #000; font-size: 1.1rem;">What the community is saying</p>
        </div>

        <a href="/games" class="btn" style="background: transparent; border: 2px solid #000; box-shadow: 4px 4px 0px #000; color: #000; font-weight: bold; padding: 12px 24px; text-decoration: none; border-radius: 8px; transition: transform 0.2s;">
          More Reviews →
        </a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">

        <% if (typeof trendingReviews !== 'undefined' && trendingReviews.length > 0) { %>

        <% trendingReviews.forEach(review => { %>

        <%
            const avatars = [];
            for (let i = 2; i <= 10; i++) {
              avatars.push(`${i}.png`);
            }
            const randomAvatar = avatars[Math.floor(Math.random() * avatars.length)];
          %>

        <div class="review-card" style="background: #ffe3e8; border: 3px solid #000; border-radius: 16px; padding: 24px; box-shadow: 8px 8px 0px #000; display: flex; flex-direction: column; gap: 16px;">

          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">

            <div style="display: flex; gap: 12px; align-items: center; flex: 1; min-width: 0;">

              <!-- Profile Image Avatar -->
              <div style="width: 48px; height: 48px; border-radius: 50%; border: 2px solid #000; overflow: hidden; flex-shrink: 0; background: #fff;">
                <img src="/assets/images/<%= randomAvatar %>" alt="Gaming Hub Profile" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              </div>

              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 900; font-family: var(--font-display); font-size: 1.1rem; color: #000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= review.user && review.user.name ? review.user.name : 'Unknown User' %>
                </div>

                <div style="font-size: 0.75rem; color: #555; font-family: var(--font-mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= new Date(review.createdAt).toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    }) %>
                  •
                  <%= review.game && review.game.title ? review.game.title : 'Game' %>
                </div>
              </div>

            </div>

            <div style="color: #ffb800; font-size: 1rem; letter-spacing: 2px; flex-shrink: 0;">
              <% for (let i = 1; i <= 5; i++) { %>
              <span style="color: <%= i <= review.rating ? '#ffb800' : '#ddd' %>">★</span>
              <% } %>
            </div>

          </div>

          <p style="color: #222; line-height: 1.6; font-size: 0.95rem; margin: 0; word-break: break-word;">
            <%= review.review %>
          </p>

        </div>

        <% }) %>

        <% } else { %>

        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; border: 2px dashed #000; border-radius: 16px; background: rgba(255,255,255,0.5);">
          <p style="color: #000; font-size: 1.2rem; font-weight: bold; margin: 0;">
            No reviews yet. Be the first to review a game!
          </p>
        </div>

        <% } %>

      </div>
    </div>
  </section>

  <!-- الفاصل عشان الـ Spacing -->
  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>

  <!-- الفاصل دا هيدي مساحة (Spacing) محترمة من تحت قبل الـ CTA -->
  <div class="hero-bubbles">
    <div class="bubble bubble-yellow"></div>
    <div class="bubble bubble-cyan"></div>
  </div>
  <!-- CTA -->
  <section class="section section--no-top">
    <div class="container">
      <div class="cta-block">
        <div class="cta-glow" aria-hidden="true"></div>
        <div class="cta-content">
          <div class="cta-eyebrow">Join the Community</div>
          <h2 class="cta-title">Your Gaming Legacy<br />Starts Here</h2>
          <p class="cta-desc">
            Join thousands of gamers discovering hidden gems, sharing unforgettable moments,
            and building their ultimate game libraries.
          </p>
          <div class="cta-actions">
            <% if (isAuth === true) { %>
            <a href="/games" class="btn btn-cyan btn-lg" style="width:100%;text-align:center">Browse Games →</a>
            <% } else { %>
            <a href="/register" class="btn btn-cyan btn-lg">Create Free Account →</a>
            <a href="/games" class="btn btn-outline-white btn-lg">Browse Games</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('../includes/footer.ejs') %>


<button class="back-to-top" id="backToTop" aria-label="Back to top">↑</button>

<link rel="stylesheet" href="/css/style.css" />
<script src="/js/app.js" defer></script>


<style>
  .genre-icon {
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .genre-icon i {
    font-size: 72px;
    color: var(--black);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: drop-shadow(3px 3px 0px rgba(17, 17, 17, 0.15));
  }

  .genre-card--dark .genre-icon i {
    color: var(--cyan);
  }

  .card:hover .genre-icon i {
    transform: scale(1.15) translateY(-6px);
  }
</style>

<%- include('../includes/end.ejs') %>