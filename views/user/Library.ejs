<%- include('../includes/head.ejs') %>

<div class="bg-shapes">
  <div class="shape shape-1"></div>
  <div class="shape shape-2"></div>
  <div class="shape shape-5">★</div>
</div>

<%- include('../includes/navbar.ejs') %>

<main class="page-wrapper">
  <div class="container">

    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:32px">
      
      <div style="display: flex; align-items: center; gap: 12px; background: var(--black); color: var(--white); padding: 12px 24px; border-radius: var(--radius-sm); border: 2px solid var(--black); box-shadow: var(--shadow-sm);">
        <span style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;">My Library</span>
        <span style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--primary); font-weight: 700;">(<%= totalGames %>)</span>
      </div>

      <a href="/games" class="btn btn-primary btn-sm">+ Add Game</a>
    </div>

    <% if (games && games.length > 0) { %>
      <div class="grid-4" style="margin-bottom:80px;">
        <% games.forEach(game => { %>
        
        <div class="game-card" data-title="<%= game.title %>" data-genre="<%= game.genre %>" data-developer="<%= game.developer %>">
          
          <div class="game-card-img">
            <img src="<%= game.imageUrl || 'https://via.placeholder.com/600x900' %>" alt="<%= game.title %>" />
            <% if (game.badge) { %>
              <span style="position: absolute; top: 8px; right: 8px; background: #ff6b6b; color: #fff; padding: 4px 8px; font-size: 0.7rem; font-family: var(--font-mono); border-radius: 4px; border: 1px solid #000; text-transform: uppercase; z-index: 2;"><%= game.badge %></span>
            <% } %>
          </div>
          
          <div class="game-card-body">
            <div class="game-card-meta"><%= game.platform %> • <%= game.year %></div>
            <h3 class="game-card-title"><%= game.title %></h3>
            <div class="game-card-sub"><%= game.genre %> | <%= game.developer %></div>

            <p class="game-card-desc"><%= game.description %></p>

            <div style="display: flex; gap: 8px; width: 100%; margin-top: auto; align-items: stretch;">
              
              <a href="/game-details/<%= game.gameId %>" class="game-card-btn" style="flex: 1; margin: 0; display: flex; align-items: center; justify-content: center; text-decoration: none;">View Game</a>
              
              <form action="/delete-from-library" method="POST" style="margin: 0; display: flex;">
                <input type="hidden" name="gameId" value="<%= game.gameId %>">
                <button type="submit" class="game-card-btn" style="width: 46px; margin: 0; padding: 0; background: var(--red); color: var(--white); display: flex; align-items: center; justify-content: center; cursor: pointer; border-color: var(--black);" title="Remove from Library">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                  </svg>
                </button>
              </form>

            </div>
          </div>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 60px 20px; min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <div style="font-family: var(--font-display); font-size: 2rem; font-weight: 900; color: var(--text-primary); margin-bottom: 16px;">Your Library is Empty</div>
        <p style="font-family: var(--font-body); font-size: 1rem; color: var(--text-muted); margin-bottom: 32px; max-width: 400px;">Start building your library by adding your favorite games!</p>
        <a href="/games" class="btn btn-primary btn-lg">Browse Games →</a>
      </div>
    <% } %>

  </div>
  <button class="back-to-top" id="backToTop" aria-label="Back to top">↑</button>
</main>

<%- include('../includes/footer.ejs') %>
<%- include('../includes/end.ejs') %>