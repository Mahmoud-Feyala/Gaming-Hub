<%- include('../includes/head.ejs') %>

<div class="bg-shapes">
  <div class="shape shape-1"></div>
  <div class="shape shape-2"></div>
  <div class="shape shape-5">★</div>
</div>

<%- include('../includes/navbar.ejs') %>

<main class="page-wrapper">
  <div class="container">

    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:32px">
      
      <div style="display: flex; align-items: center; gap: 12px; background: var(--black); color: var(--white); padding: 12px 24px; border-radius: var(--radius-sm); border: 2px solid var(--black); box-shadow: var(--shadow-sm);">
        <span style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;">My Library</span>
        <span style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--cyan); font-weight: 700;">(<%= totalGames %>)</span>
      </div>

      <a href="/games" class="btn btn-primary btn-sm">+ Add Game</a>
    </div>

    <% if (games && games.length > 0) { %>
      <div class="grid-4" style="margin-bottom:80px;">
        <% games.forEach(game => { %>
        <div class="game-card" data-title="<%= game.title %>" data-genre="<%= game.genre %>" data-developer="<%= game.developer %>" style="background: var(--black, #111); color: #fff; border: 2px solid #000; border-radius: 8px; overflow: hidden; box-shadow: 4px 4px 0px rgba(0,0,0,0.2); display: flex; flex-direction: column;">
          <div class="card-image-container" style="border-bottom: 2px solid #000; position: relative; overflow: hidden;">
            <img src="<%= game.imageUrl || 'https://via.placeholder.com/600x900' %>" alt="<%= game.title %>" style="width: 100%; display: block;" />
            <% if (game.badge) { %>
              <span style="position: absolute; top: 8px; right: 8px; background: #ff6b6b; color: #fff; padding: 4px 8px; font-size: 0.7rem; font-family: var(--font-mono); border-radius: 4px; border: 1px solid #000; text-transform: uppercase; z-index: 2;"><%= game.badge %></span>
            <% } %>
          </div>
          <div style="padding: 16px; flex-grow: 1; display: flex; flex-direction: column;">
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: #888; text-transform: uppercase; margin-bottom: 8px;"><%= game.platform %> • <%= game.year %></div>
            <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 4px 0;"><%= game.title %></h3>
            <div style="font-size: 0.8rem; color: #aaa; margin-bottom: 12px;"><%= game.genre %> | <%= game.developer %></div>

            <p style="font-size: 0.85rem; line-height: 1.4; color: #ddd; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;"><%= game.description %></p>

            <a href="/game-details/<%= game.gameId %>" class="btn btn-cyan" style="width: 100%; text-align: center; margin-top: auto;">View Game</a>

          </div>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 60px 20px; min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <div style="font-family: var(--font-display); font-size: 2rem; font-weight: 900; color: var(--black); margin-bottom: 16px;">Your Library is Empty</div>
        <p style="font-family: var(--font-body); font-size: 1rem; color: var(--gray); margin-bottom: 32px; max-width: 400px;">Start building your library by adding your favorite games!</p>
        <a href="/games" class="btn btn-primary btn-lg">Browse Games →</a>
      </div>
    <% } %>

  </div>
  <button class="back-to-top" id="backToTop" aria-label="Back to top">↑</button>
</main>

<%- include('../includes/footer.ejs') %>

<%- include('../includes/end.ejs') %>