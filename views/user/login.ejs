<%- include('../includes/head.ejs') %>

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <div class="logo-icon">
        <img src="/assets/images/1.png" alt="Gaming Hub Logo" />
      </div>
      <div class="logo-text">Gaming<span>Hub</span></div>
    </a>
    <ul class="navbar-nav">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/games" class="nav-link">Games</a></li>
      <% if (isAuth === true) { %>
      <li><a href="/Library" class="nav-link">My Library</a></li>
      <li><a href="/admin/admin-dashboard" class="nav-link">Admin</a></li>
      <li><a href="/profile" class="nav-link">Profile</a></li>
      <% } %>
    </ul>
    <div class="navbar-actions">
      <% if (isAuth === false) { %>
      <a href="/login" class="btn btn-outline-white btn-sm">Log In</a>
      <a href="/signup" class="btn btn-cyan btn-sm">Sign Up</a>
      <% } else { %>
      <a href="/logout" class="btn btn-outline-white btn-sm">Log Out</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="auth-layout">
  <!-- Left Panel -->
  <div class="auth-left">
    <div class="auth-left-content">
      <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--cyan);text-transform:uppercase;letter-spacing:0.15em;margin-bottom:20px">Welcome Back</div>
      <h1 class="auth-headline">Back in<br>the <span>Game</span></h1>
      <p class="auth-subtext">Log in to access your personal library, post reviews, and connect with a community of passionate gamers.</p>




      <!-- Decorative floating dots -->
      <div style="position:absolute;bottom:60px;right:60px;display:flex;gap:12px;opacity:0.4">
        <div style="width:56px;height:56px;background:var(--yellow);border:2px solid var(--white);border-radius:50%;animation:float1 5s ease-in-out infinite"></div>
        <div style="width:36px;height:36px;background:var(--cyan);border:2px solid var(--white);border-radius:50%;animation:float2 7s ease-in-out infinite 1s"></div>
      </div>
    </div>
  </div>
  <div class="auth-bg-shapes">
    <div class="auth-shape shape-cross" style="top: 35%; left: 15%;">+</div>
    <div class="auth-shape shape-cross" style="bottom: 25%; left: 35%;">+</div>
    <div class="auth-shape shape-cross" style="top: 45%; right: 15%;">+</div>

    <div class="auth-shape shape-hollow-circle pink" style="top: 25%; left: 5%;"></div>
    <div class="auth-shape shape-hollow-circle yellow" style="top: 15%; right: 30%;"></div>

    <div class="auth-shape shape-action-line pink" style="bottom: 5%; left: 10%;"></div>
    <div class="auth-shape shape-action-line cyan" style="bottom: 10%; left: 20%;"></div>
    <div class="auth-shape shape-action-line pink" style="top: 15%; right: -5%;"></div>
    <div class="auth-shape shape-action-line cyan" style="top: 10%; right: -10%;"></div>

    <svg class="auth-shape shape-svg white" style="top: 20%; left: 30%; width: 60px; height: 60px;" viewBox="0 0 24 24">
      <path d="M2 12a10 10 0 0 1 20 0c0 4.5-2.5 8-5 8h-10c-2.5 0-5-3.5-5-8z" />
      <path d="M6 12h4m-2-2v4" />
      <circle cx="15" cy="11" r="1.5" fill="currentColor" />
      <circle cx="17" cy="13" r="1.5" fill="currentColor" />
    </svg>

    <svg class="auth-shape shape-svg yellow" style="bottom: 20%; left: 15%; width: 50px; height: 50px;" viewBox="0 0 24 24">
      <path d="M2 20h20M4 20l2-12 4 4 2-6 2 6 4-4 2 12" />
    </svg>

    <svg class="auth-shape shape-svg cyan" style="top: 45%; right: 25%; width: 35px; height: 35px;" viewBox="0 0 24 24">
      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
    </svg>
  </div>

  <!-- Right Panel: Form -->
  <div class="auth-right">
    <div class="auth-form-card">
      <div class="auth-form-title">Log In</div>
      <div class="auth-form-subtitle">Enter your credentials to continue</div>

      <%- include('../includes/flash-messages.ejs') %>

      <!-- Social Login -->
      <a href="#" class="btn-social" onclick="View.showToast('Connecting with Google...','info');return false">
        <span style="font-size:1.1rem">G</span> Continue with Google
      </a>
      <a href="#" class="btn-social" onclick="View.showToast('Connecting with Discord...','info');return false">
        <span style="font-size:1.1rem">💬</span> Continue with Discord
      </a>

      <div class="auth-divider">
        <div class="auth-divider-line"></div>
        <div class="auth-divider-text">or</div>
        <div class="auth-divider-line"></div>
      </div>

      <!-- Login Form -->
      <form id="login-form" action="/login" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input class="form-input <%= validationErrors.find(e => e.path === 'email') ? 'input-error' : '' %>" type="email" name="email" value="<%= oldInput.email %>" placeholder="gamer@example.com" required autocomplete="email" />
        </div>

        <div class="form-group">
          <label class="form-label" style="display:flex;justify-content:space-between;align-items:center">
            Password
            <a href="/forgot-password" style="font-family:var(--font-mono);font-size:0.65rem;color:var(--black);font-weight:400;text-decoration:underline">Forgot password?</a>
          </label>
          <div style="position:relative">
            <input class="form-input <%= validationErrors.find(e => e.path === 'password') ? 'input-error' : '' %>" type="password" name="password" id="password-field" value="<%= oldInput.password %>" placeholder="••••••••" required autocomplete="current-password" />
            <button type="button" onclick="togglePw()" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:1rem;color:var(--gray)">👁</button>
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px">
          <input type="checkbox" id="remember" name="remember" style="width:18px;height:18px;accent-color:var(--cyan);cursor:pointer" />
          <label for="remember" style="font-family:var(--font-body);font-size:0.9rem;color:var(--text-muted);cursor:pointer;font-weight:500">Remember me for 30 days</label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;padding:16px;font-size:0.9rem">Log In →</button>
      </form>

      <div class="auth-switch-text">
        Don't have an account? <a href="/signup">Sign up free</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
  function togglePw() {
    const f = document.getElementById('password-field');
    f.type = f.type === 'password' ? 'text' : 'password';
  }
</script>
</body>

</html>