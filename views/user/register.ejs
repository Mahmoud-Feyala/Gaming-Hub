<%- include('../includes/head.ejs') %>
<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <div class="logo-icon">
        <img src="/assets/images/1.png" alt="Gaming Hub Logo" />
      </div>
      <div class="logo-text">Gaming<span>Hub</span></div>
    </a>
    <ul class="navbar-nav">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/games" class="nav-link">Games</a></li>
      <% if (isAuth === true) { %>
      <li><a href="/Library" class="nav-link">My Library</a></li>
      <li><a href="/admin/admin-dashboard" class="nav-link">Admin</a></li>
      <li><a href="/profile" class="nav-link">Profile</a></li>
      <% } %>
    </ul>
    <div class="navbar-actions">
      <% if (isAuth === false) { %>
      <a href="/login" class="btn btn-outline-white btn-sm">Log In</a>
      <a href="/signup" class="btn btn-cyan btn-sm">Sign Up</a>
      <% } else { %>
      <a href="/logout" class="btn btn-outline-white btn-sm">Log Out</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="auth-layout">
  <!-- Left Panel -->
  <div class="auth-left">
    <div class="auth-left-content">
      <div style="
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--cyan);
              text-transform: uppercase;
              letter-spacing: 0.15em;
              margin-bottom: 20px;
            ">
        Join PixelVault
      </div>
      <h1 class="auth-headline">
        Start Your<br /><span>Gaming</span><br />Legacy
      </h1>
      <p class="auth-subtext">
        Create your free account and join 42,000+ gamers who rate, review
        and discover incredible games every day.
      </p>


      <!-- Decorative -->
      <div style="
              position: absolute;
              bottom: 60px;
              right: 40px;
              display: flex;
              gap: 10px;
              opacity: 0.35;
            ">
        <div style="
                width: 64px;
                height: 64px;
                background: var(--orange);
                border: 2px solid var(--white);
                border-radius: 50%;
                animation: float1 6s ease-in-out infinite;
              "></div>
        <div style="
                width: 40px;
                height: 40px;
                background: var(--pink);
                border: 2px solid var(--white);
                border-radius: 50%;
                animation: float2 8s ease-in-out infinite 2s;
              "></div>
      </div>
    </div>
  </div>

  <!-- Right Panel -->
  <div class="auth-right">
    <div class="auth-form-card">
      <div class="auth-form-title">Create Account</div>
      <div class="auth-form-subtitle">
        It's free — no credit card needed
      </div>

      <%- include('../includes/flash-messages.ejs') %>

      <!-- Social -->
      <a href="#" class="btn-social" onclick="
              View.showToast('Connecting with Google...', 'info');
              return false;
            ">
        <span style="font-size: 1.1rem">G</span> Sign up with Google
      </a>
      <a href="#" class="btn-social" onclick="
              View.showToast('Connecting with Discord...', 'info');
              return false;
            ">
        <span style="font-size: 1.1rem">💬</span> Sign up with Discord
      </a>

      <div class="auth-divider">
        <div class="auth-divider-line"></div>
        <div class="auth-divider-text">or fill in the form</div>
        <div class="auth-divider-line"></div>
      </div>
      <form id="register-form" action="/signup" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-row">
          <div class="form-group" style="margin-bottom: 0">
            <label class="form-label">First Name</label>
            <input class="form-input" type="text" name="firstName" placeholder="Alex" value="<%= oldInput.firstName || '' %>" />
          </div>

          <div class="form-group" style="margin-bottom: 0">
            <label class="form-label">Last Name</label>
            <input class="form-input" type="text" name="lastName" placeholder="Gamer" value="<%= oldInput.lastName || '' %>" />
          </div>
        </div>

        <div class="form-group" style="margin-top: 20px">
          <label class="form-label">Username</label>
          <div style="position: relative">
            <span style="
          position: absolute;
          left: 16px;
          top: 50%;
          transform: translateY(-50%);
          font-family: var(--font-mono);
          font-size: 0.85rem;
          color: var(--gray);
        ">@</span>

            <input class="form-input" type="text" name="username" placeholder="pixelwarrior99" style="padding-left: 36px" value="<%= oldInput.username || '' %>" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input class="form-input" type="email" name="email" placeholder="gamer@example.com" value="<%= oldInput.email || '' %>" />
        </div>

        <div class="form-group">
          <label class="form-label">Password</label>

          <div style="position: relative">
            <input class="form-input" type="password" name="password" id="pw1" placeholder="At least 8 characters" />

            <button type="button" onclick="togglePw('pw1')" style="
          position: absolute;
          right: 14px;
          top: 50%;
          transform: translateY(-50%);
          background: none;
          border: none;
          cursor: pointer;
          font-size: 1rem;
          color: var(--gray);
        ">
              👁
            </button>
          </div>

          <div style="margin-top: 8px">
            <div class="progress-bar">
              <div class="progress-fill" id="password-strength" style="
            width: 0%;
            transition:
              width 0.4s ease,
              background 0.4s ease;
          "></div>
            </div>

            <div style="
          font-family: var(--font-mono);
          font-size: 0.65rem;
          color: var(--gray);
          margin-top: 4px;
        ">
              Password strength
            </div>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Confirm Password</label>

          <div style="position: relative">
            <input class="form-input" type="password" name="confirmPassword" id="pw2" placeholder="Repeat password" />

            <button type="button" onclick="togglePw('pw2')" style="
          position: absolute;
          right: 14px;
          top: 50%;
          transform: translateY(-50%);
          background: none;
          border: none;
          cursor: pointer;
          font-size: 1rem;
          color: var(--gray);
        ">
              👁
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Favourite Genre</label>

          <select class="form-select" name="favoriteGenre">
            <option value="">Select your main genre...</option>
            <option value="Action" <%= oldInput.favoriteGenre === 'Action' ? 'selected' : '' %>>Action</option>
            <option value="RPG" <%= oldInput.favoriteGenre === 'RPG' ? 'selected' : '' %>>RPG</option>
            <option value="Racing" <%= oldInput.favoriteGenre === 'Racing' ? 'selected' : '' %>>Racing</option>
            <option value="Strategy" <%= oldInput.favoriteGenre === 'Strategy' ? 'selected' : '' %>>Strategy</option>
            <option value="Horror" <%= oldInput.favoriteGenre === 'Horror' ? 'selected' : '' %>>Horror</option>
            <option value="Fighting" <%= oldInput.favoriteGenre === 'Fighting' ? 'selected' : '' %>>Fighting</option>
            <option value="Sports" <%= oldInput.favoriteGenre === 'Sports' ? 'selected' : '' %>>Sports</option>
            <option value="Puzzle" <%= oldInput.favoriteGenre === 'Puzzle' ? 'selected' : '' %>>Puzzle</option>
          </select>
        </div>

        <div style="
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 28px;
    ">
          <input type="checkbox" id="terms" name="terms" style="
        width: 18px;
        height: 18px;
        accent-color: var(--cyan);
        cursor: pointer;
        margin-top: 2px;
        flex-shrink: 0;
      " />

          <label for="terms" style="
        font-family: var(--font-body);
        font-size: 0.88rem;
        color: var(--text-muted);
        cursor: pointer;
        font-weight: 500;
        line-height: 1.5;
      ">
            I agree to the
            <a href="/terms" style="color: var(--black); font-weight: 700">
              Terms of Service
            </a>
            and
            <a href="/privacy" style="color: var(--black); font-weight: 700">
              Privacy Policy
            </a>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 0.9rem">
          Create My Account →
        </button>
      </form>

      <div class="auth-switch-text">
        Already have an account? <a href="/login">Log in</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
  function togglePw(id) {
    const f = document.getElementById(id);
    f.type = f.type === "password" ? "text" : "password";
  }
</script>
</body>

</html>
