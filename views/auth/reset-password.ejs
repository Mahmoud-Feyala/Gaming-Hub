<%- include('../includes/head.ejs') %>

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <div class="logo-icon">
        <img src="/assets/images/1.png" alt="Gaming Hub Logo" />
      </div>
      <div class="logo-text">Gaming<span>Hub</span></div>
    </a>
    <ul class="navbar-nav">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/games" class="nav-link">Games</a></li>
      <% if (isAuth === true) { %>
      <li><a href="/Library" class="nav-link">My Library</a></li>
      <li><a href="/admin/admin-dashboard" class="nav-link">Admin</a></li>
      <li><a href="/profile" class="nav-link">Profile</a></li>
      <% } %>
    </ul>
    <div class="navbar-actions">
      <% if (isAuth === false) { %>
      <a href="/login" class="btn btn-outline-white btn-sm">Log In</a>
      <a href="/signup" class="btn btn-cyan btn-sm">Sign Up</a>
      <% } else { %>
      <a href="/logout" class="btn btn-outline-white btn-sm">Log Out</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="auth-layout">
  <!-- Left Panel -->
  <div class="auth-left">
    <div class="auth-left-content">
      <div style="
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--cyan);
              text-transform: uppercase;
              letter-spacing: 0.15em;
              margin-bottom: 20px;
            ">
        Almost There
      </div>
      <h1 class="auth-headline">
        Set A New<br /><span>Password</span>
      </h1>
      <p class="auth-subtext">
        Choose a strong password you haven't used before to keep your
        account safe and secure.
      </p>

      <!-- Decorative -->
      <div style="
              position: absolute;
              bottom: 60px;
              right: 40px;
              display: flex;
              gap: 10px;
              opacity: 0.35;
            ">
        <div style="
                width: 64px;
                height: 64px;
                background: var(--cyan);
                border: 2px solid var(--white);
                border-radius: 50%;
                animation: float1 6s ease-in-out infinite;
              "></div>
        <div style="
                width: 40px;
                height: 40px;
                background: var(--orange);
                border: 2px solid var(--white);
                border-radius: 50%;
                animation: float2 8s ease-in-out infinite 2s;
              "></div>
      </div>
    </div>
  </div>

  <!-- Right Panel -->
  <div class="auth-right">
    <div class="auth-form-card">
      <div class="auth-form-title">New Password</div>
      <div class="auth-form-subtitle">
        Your new password must be different from previous ones
      </div>

      <%- include('../includes/flash-messages.ejs') %>

      <form id="reset-password-form" action="/reset-password/<%= token %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label">New Password</label>
          <div style="position: relative">
            <input class="form-input" type="password" name="password" id="pw1" placeholder="At least 8 characters" required autocomplete="new-password" />
            <button type="button" onclick="togglePw('pw1')" style="
          position: absolute;
          right: 14px;
          top: 50%;
          transform: translateY(-50%);
          background: none;
          border: none;
          cursor: pointer;
          font-size: 1rem;
          color: var(--gray);
        ">
              👁
            </button>
          </div>

          <div style="margin-top: 8px">
            <div class="progress-bar">
              <div class="progress-fill" id="password-strength" style="
            width: 0%;
            transition:
              width 0.4s ease,
              background 0.4s ease;
          "></div>
            </div>

            <div style="
          font-family: var(--font-mono);
          font-size: 0.65rem;
          color: var(--gray);
          margin-top: 4px;
        ">
              Password strength
            </div>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Confirm New Password</label>
          <div style="position: relative">
            <input class="form-input" type="password" name="confirmPassword" id="pw2" placeholder="Repeat password" required autocomplete="new-password" />
            <button type="button" onclick="togglePw('pw2')" style="
          position: absolute;
          right: 14px;
          top: 50%;
          transform: translateY(-50%);
          background: none;
          border: none;
          cursor: pointer;
          font-size: 1rem;
          color: var(--gray);
        ">
              👁
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 0.9rem; margin-top: 8px;">
          Reset Password →
        </button>
      </form>

      <div class="auth-switch-text">
        Remembered it after all? <a href="/login">Log in</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
  function togglePw(id) {
    const f = document.getElementById(id);
    f.type = f.type === "password" ? "text" : "password";
  }

  // basic password strength meter
  const pw1 = document.getElementById('pw1');
  const strengthBar = document.getElementById('password-strength');
  if (pw1 && strengthBar) {
    pw1.addEventListener('input', () => {
      const val = pw1.value;
      let score = 0;
      if (val.length >= 8) score += 25;
      if (/[A-Z]/.test(val)) score += 25;
      if (/[0-9]/.test(val)) score += 25;
      if (/[^A-Za-z0-9]/.test(val)) score += 25;
      strengthBar.style.width = score + '%';
      strengthBar.style.background = score < 50 ? 'var(--pink)' : score < 100 ? 'var(--yellow)' : 'var(--cyan)';
    });
  }
</script>
</body>

</html>
