<%- include('../includes/head.ejs') %>

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <div class="logo-icon">
        <img src="/assets/images/1.png" alt="Gaming Hub Logo" />
      </div>
      <div class="logo-text">Gaming<span>Hub</span></div>
    </a>
    <ul class="navbar-nav">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/games" class="nav-link">Games</a></li>
      <% if (isAuth === true) { %>
      <li><a href="/Library" class="nav-link">My Library</a></li>
      <li><a href="/admin/admin-dashboard" class="nav-link">Admin</a></li>
      <li><a href="/profile" class="nav-link">Profile</a></li>
      <% } %>
    </ul>
    <div class="navbar-actions">
      <% if (isAuth === false) { %>
      <a href="/login" class="btn btn-outline-white btn-sm">Log In</a>
      <a href="/signup" class="btn btn-cyan btn-sm">Sign Up</a>
      <% } else { %>
      <a href="/logout" class="btn btn-outline-white btn-sm">Log Out</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="auth-layout">
  <!-- Left Panel -->
  <div class="auth-left">
    <div class="auth-left-content">
      <div style="
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--cyan);
              text-transform: uppercase;
              letter-spacing: 0.15em;
              margin-bottom: 20px;
            ">
        Account Recovery
      </div>
      <h1 class="auth-headline">
        Forgot Your<br /><span>Password</span>?
      </h1>
      <p class="auth-subtext">
        No worries, it happens to everyone. Enter your email address below
        and we'll send you a link to reset your password.
      </p>

      <!-- Decorative -->
      <div style="
              position: absolute;
              bottom: 60px;
              right: 40px;
              display: flex;
              gap: 10px;
              opacity: 0.35;
            ">
        <div style="
                width: 64px;
                height: 64px;
                background: var(--pink);
                border: 2px solid var(--white);
                border-radius: 50%;
                animation: float1 6s ease-in-out infinite;
              "></div>
        <div style="
                width: 40px;
                height: 40px;
                background: var(--yellow);
                border: 2px solid var(--white);
                border-radius: 50%;
                animation: float2 8s ease-in-out infinite 2s;
              "></div>
      </div>
    </div>
  </div>

  <!-- Right Panel -->
  <div class="auth-right">
    <div class="auth-form-card">
      <div class="auth-form-title">Reset Password</div>
      <div class="auth-form-subtitle">
        Enter the email associated with your account
      </div>

      <%- include('../includes/flash-messages.ejs') %>

      <form id="forgot-password-form" action="/forgot-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input class="form-input" type="email" name="email" placeholder="gamer@example.com" required autocomplete="email" />
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 0.9rem; margin-top: 8px;">
          Send Reset Link →
        </button>
      </form>

      <div class="auth-switch-text">
        Remembered your password? <a href="/login">Log in</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
</body>

</html>
