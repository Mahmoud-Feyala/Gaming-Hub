<%- include('../includes/head.ejs') %>
<%- include('../includes/admin-navbar.ejs') %>

<div class="admin-layout" style="padding-top:72px">
  <aside class="admin-sidebar">
    <div style="padding:24px;border-bottom:1px solid rgba(255,255,255,0.08)">
      <div style="font-family:var(--font-display);font-size:0.8rem;font-weight:700;color:var(--white)">Admin Panel</div>
      <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--gray);margin-top:4px">GamingHub v1.5</div>
    </div>

    <div class="admin-sidebar-title">Overview</div>
    <a href="/admin/admin-dashboard" class="admin-nav-item">
      <span class="admin-nav-icon"></span> Dashboard
    </a>

    <div class="admin-sidebar-title">Content</div>
    <a href="/admin/admin-games" class="admin-nav-item">
      <span class="admin-nav-icon"></span> All Games
    </a>
    <a href="/admin/admin-addGames" class="admin-nav-item">
      <span class="admin-nav-icon"></span> Add Game
    </a>
    <a href="/admin/reviews" class="admin-nav-item active">
      <span class="admin-nav-icon"></span> Reviews
    </a>

    <div style="position:absolute;bottom:24px;left:0;right:0;padding:0 16px">
      <a href="/" class="btn btn-outline-white btn-sm" style="width:100%">← Back to Site</a>
    </div>
  </aside>

  <main class="admin-content">
    <div class="admin-panel">
      <div class="admin-page-title">Reviews Management</div>
      <div class="admin-page-subtitle">Manage player reviews across all games.</div>

      <div class="admin-table-card" style="padding:24px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
          <div style="font-family:var(--font-display);font-size:1.1rem;font-weight:800;color:var(--black)">All Reviews</div>
          <div class="tag tag-cyan">Total: <%= reviews.length %></div>
        </div>

        <% if(reviews.length === 0){ %>
          <div style="text-align:center;padding:32px 16px;color:var(--gray)">
            <h2 style="margin-bottom:8px">No Reviews Found</h2>
            <p>Players haven't posted any reviews yet.</p>
          </div>
        <% } else { %>
          <div style="display:grid;gap:16px">
            <% reviews.forEach(review=>{ %>
              <article style="border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:20px;background:var(--white)">
                <div style="display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:12px">
                  <div>
                    <h3 style="margin:0 0 6px;color:var(--black)"><%= review.game.title %></h3>
                    <p style="margin:0;color:var(--gray)">by <strong><%= review.user.name %></strong></p>
                  </div>
                  <span class="tag tag-yellow">⭐ <%= review.rating %>/5</span>
                </div>

                <p style="margin:0 0 16px;line-height:1.7;color:var(--black)"><%= review.review %></p>

                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
                  <span style="font-family:var(--font-mono);font-size:0.75rem;color:var(--gray)"><%= review.createdAt.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"}) %></span>
                  <form action="/admin/delete-review" method="POST">
                    <input type="hidden" name="reviewId" value="<%= review._id %>">
                    <button class="btn btn-danger btn-sm" type="submit">Delete Review</button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../includes/end.ejs') %>