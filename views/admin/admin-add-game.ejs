<%- include('../includes/head.ejs') %>
<%- include('../includes/admin-navbar.ejs') %>

<div class="admin-layout" style="padding-top: 72px">
  <aside class="admin-sidebar">
    <div style="padding: 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.08)">
      <div style="font-family: var(--font-display); font-size: 0.8rem; font-weight: 700; color: var(--white);">
        Admin Panel
      </div>
      <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--gray); margin-top: 4px;">
        GamingHub v1.0
      </div>
    </div>

    <div class="admin-sidebar-title">Overview</div>
    <a href="/admin/admin-dashboard" class="admin-nav-item">
      <span class="admin-nav-icon"></span>
      Dashboard
    </a>

    <div class="admin-sidebar-title">Content</div>
    <a href="/admin/admin-games" class="admin-nav-item">
      <span class="admin-nav-icon"></span>
      All Games
    </a>

    <a href="/admin/admin-addGames" class="admin-nav-item active">
      <span class="admin-nav-icon"></span>
      <% if (editing) { %>Edit Game<% } else { %>Add Game<% } %>
    </a>

    <a href="/admin/reviews" class="admin-nav-item">
      <span class="admin-nav-icon"></span>
      Reviews
    </a>

    <div style="position: absolute; bottom: 24px; left: 0; right: 0; padding: 0 16px;">
      <a href="/" class="btn btn-outline-white btn-sm" style="width: 100%">
        ← Back to Site
      </a>
    </div>
  </aside>

  <main class="admin-content">
    <div class="admin-panel">
      <div class="admin-page-title"><% if (editing) { %>Edit Game<% } else { %>Add New Game<% } %></div>
      <div class="admin-page-subtitle">
        <% if (editing) { %>Update the details of this game in the catalog<% } else { %>Fill in the details to add a game to the catalog<% } %>
      </div>

      <div class="add-game-form">
        <%- include('../includes/flash-messages.ejs') %>

        <form id="add-game-form" action="/admin/<% if (editing) { %>edit-game<% } else { %>add-game<% } %>" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-divider">Basic Info</div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label"> Game Title * </label>
              <input class="form-input <%= validationErrors.find(e => e.path === 'title') ? 'input-error' : '' %>" type="text" name="title" value="<%= game.title %>" placeholder="e.g. Neon Drift 2" required />
            </div>

            <div class="form-group">
              <label class="form-label"> Genre * </label>
              <select class="form-select <%= validationErrors.find(e => e.path === 'genre') ? 'input-error' : '' %>" name="genre" required>
                <option value="">Select genre...</option>
                <option value="Action" <%= game.genre === 'Action' ? 'selected' : '' %>>Action</option>
                <option value="Adventure" <%= game.genre === 'Adventure' ? 'selected' : '' %>>Adventure</option>
                <option value="Shooter" <%= game.genre === 'Shooter' ? 'selected' : '' %>>Shooter</option>
                <option value="RPG" <%= game.genre === 'RPG' ? 'selected' : '' %>>RPG</option>
                <option value="Racing" <%= game.genre === 'Racing' ? 'selected' : '' %>>Racing</option>
                <option value="Sports" <%= game.genre === 'Sports' ? 'selected' : '' %>>Sports</option>
                <option value="Strategy" <%= game.genre === 'Strategy' ? 'selected' : '' %>>Strategy</option>
                <option value="Simulation" <%= game.genre === 'Simulation' ? 'selected' : '' %>>Simulation</option>
                <option value="Fighting" <%= game.genre === 'Fighting' ? 'selected' : '' %>>Fighting</option>
                <option value="Horror" <%= game.genre === 'Horror' ? 'selected' : '' %>>Horror</option>
                <option value="Survival" <%= game.genre === 'Survival' ? 'selected' : '' %>>Survival</option>
                <option value="Indie" <%= game.genre === 'Indie' ? 'selected' : '' %>>Indie</option>
                <option value="Puzzle" <%= game.genre === 'Puzzle' ? 'selected' : '' %>>Puzzle</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label"> Developer * </label>
              <input class="form-input <%= validationErrors.find(e => e.path === 'developer') ? 'input-error' : '' %>" type="text" name="developer" value="<%= game.developer %>" placeholder="e.g. VoltStudios" required />
            </div>

            <div class="form-group">
              <label class="form-label"> Platform * </label>
              <select class="form-select <%= validationErrors.find(e => e.path === 'platform') ? 'input-error' : '' %>" name="platform" required>
                <option value="PC" <%= game.platform === 'PC' ? 'selected' : '' %>>PC</option>
                <option value="PS5" <%= game.platform === 'PS5' ? 'selected' : '' %>>PS5</option>
                <option value="Xbox" <%= game.platform === 'Xbox' ? 'selected' : '' %>>Xbox</option>
                <option value="Switch" <%= game.platform === 'Switch' ? 'selected' : '' %>>Nintendo Switch</option>
                <option value="Mobile" <%= game.platform === 'Mobile' ? 'selected' : '' %>>Mobile</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label"> Release Year * </label>
              <input class="form-input <%= validationErrors.find(e => e.path === 'year') ? 'input-error' : '' %>" type="number" name="year" value="<%= game.year %>" placeholder="2024" min="1980" max="2030" required />
            </div>

            <div class="form-group">
              <label class="form-label"> Badge </label>
              <select class="form-select <%= validationErrors.find(e => e.path === 'badge') ? 'input-error' : '' %>" name="badge">
                <option value="" <%= (!game.badge || game.badge === '') ? 'selected' : '' %>>None</option>
                <option value="new" <%= game.badge === 'new' ? 'selected' : '' %>>New</option>
                <option value="featured" <%= game.badge === 'featured' ? 'selected' : '' %>>Featured</option>
                <option value="trending" <%= game.badge === 'trending' ? 'selected' : '' %>>Trending</option>
                <option value="early-access" <%= game.badge === 'early-access' ? 'selected' : '' %>>Early Access</option>
                <option value="top-rated" <%= game.badge === 'top-rated' ? 'selected' : '' %>>Top Rated</option>
                <option value="sale" <%= game.badge === 'sale' ? 'selected' : '' %>>On Sale</option>
                <option value="staff-pick" <%= game.badge === 'staff-pick' ? 'selected' : '' %>>Staff Pick</option>
                <option value="coming-soon" <%= game.badge === 'coming-soon' ? 'selected' : '' %>>Coming Soon</option>
              </select>
            </div>
          </div>

          <div class="form-divider">Media & Details</div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label"> Image URL * </label>
              <input class="form-input <%= validationErrors.find(e => e.path === 'imageUrl') ? 'input-error' : '' %>" type="text" name="imageUrl" value="<%= game.imageUrl %>" placeholder="e.g. /images/neon.jpg" required />
            </div>

            <div class="form-group">
              <label class="form-label"> Trailer URL (YouTube Embed) </label>
              <input class="form-input <%= validationErrors.find(e => e.path === 'trailerUrl') ? 'input-error' : '' %>" type="text" name="trailerUrl" value="<%= game.trailerUrl %>" placeholder="e.g. https://www.youtube.com/embed/VIDEO_ID" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group" style="flex: 1">
              <label class="form-label"> Tags (Comma Separated) * </label>
              <input class="form-input <%= validationErrors.find(e => e.path === 'tags') ? 'input-error' : '' %>" type="text" name="tags" value="<%= game.tags %>" placeholder="e.g. Multiplayer, Fast-Paced" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label"> Description * </label>
            <textarea class="form-textarea <%= validationErrors.find(e => e.path === 'description') ? 'input-error' : '' %>" name="description" placeholder="Write a compelling game description..." style="min-height: 140px" required><%= game.description %></textarea>
          </div>

          <% if (editing || hasError && game._id) { %>
          <input type="hidden" value="<%= game._id %>" name="gameId">
          <% } %>

          <% if (isAuth === true) { %>
          <div style="display: flex; gap: 12px; margin-top: 24px">
            <button type="submit" class="btn btn-primary btn-lg">
              <% if (editing) { %>Update Game Details →<% } else { %>Add Game to Catalog →<% } %>
            </button>
            <button type="reset" class="btn btn-outline btn-lg">
              Reset Form
            </button>
          </div>
          <% } %>
        </form>
      </div>
    </div>
  </main>
</div>

<%- include('../includes/end.ejs') %>